{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/app",
        "dev"
      ],
      "port": 1420
    },
    {
      "name": "site-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "site"
      ],
      "port": 4173
    },
    {
      "name": "lansend-web",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4174",
        "--directory",
        "lansend_web"
      ],
      "port": 4174
    }
  ]
}

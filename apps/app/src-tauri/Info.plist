<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Merged into the generated macOS Info.plist by `tauri build` (iOS uses Info.ios.plist). -->
    <!-- Only standard TLS (rustls) is used: exempt from export documentation. -->
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Wang Sheng</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <!-- macOS 15+ asks before an app may talk to the local network. -->
    <!-- Shown by macOS the first time the sandboxed app writes a received file into ~/Downloads. -->
    <key>NSDownloadsFolderUsageDescription</key>
    <string>LanSend saves files received from your other devices to your Downloads folder. You can pick a different folder in Settings.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>LanSend finds other devices on your Wi‑Fi and sends files to them directly.</string>
</dict>
</plist>

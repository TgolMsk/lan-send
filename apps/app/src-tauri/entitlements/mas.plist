<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for TestFlight on macOS: must match the embedded provisioning profile. -->
	<key>com.apple.application-identifier</key>
	<string>VVB976RN4W.com.wangsheng.lansend</string>
	<key>com.apple.developer.team-identifier</key>
	<string>VVB976RN4W</string>
    <!-- Mac App Store build: sandboxed (ADR-0014). -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Outgoing connections to peers and the HTTPS server peers connect to. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- LAN discovery: UDP multicast 224.0.0.167 / ff12::fd3a:e420 (LocalSend v2).
         Sandboxed builds cannot join multicast groups without it. Granted by
         Apple on 2026-09-13; the embedded provisioning profile must include the
         Multicast Networking capability or codesign rejects the entitlement. -->
    <key>com.apple.developer.networking.multicast</key>
    <true/>
    <!-- Files the user picks to send, and the receive folder they choose. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- The default receive folder. -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    <!-- Keeps access to a chosen receive folder across launches. -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
</dict>
</plist>
